#!/bin/sh
set -e
lb config noauto \
    --distribution trixie \
    --architectures amd64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --binary-images iso-hybrid \
    --debian-installer none \
    --apt-recommends false \
    --memtest none \
    --iso-application "ClairOS" \
    --iso-publisher "ClairOS by Gab9SG" \
    --iso-volume "CLAIROS" \
    --bootappend-live "boot=live components quiet locales=fr_FR.UTF-8 keyboard-layouts=fr timezone=Europe/Paris username=user live-config.username=user" \
    "${@}"
