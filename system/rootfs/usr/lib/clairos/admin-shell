#!/bin/bash
# Shell administrateur (root) ouvert par « Administration > Terminal (CMD) ».
# Appelé par l'application : sudo -n /usr/lib/clairos/admin-shell
if [ "$(id -u)" -ne 0 ]; then
    echo "Ce script doit être lancé avec sudo." >&2
    exit 1
fi
export HOME=/root USER=root LOGNAME=root SHELL=/bin/bash
export TERM="${TERM:-xterm-256color}"
cd /root || cd /
exec /bin/bash --rcfile /usr/lib/clairos/admin-shell.bashrc -i
