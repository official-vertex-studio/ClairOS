{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ClairOS by Gab9SG",
  "version": "0.1.0",
  "identifier": "com.gab9sg.clairos",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ClairOS by Gab9SG",
        "width": 1280,
        "height": 800,
        "resizable": false,
        "fullscreen": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "Utility",
    "shortDescription": "La technologie, simplement.",
    "longDescription": "ClairOS by Gab9SG est un environnement Linux simple et accessible.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "mainBinaryName": "clairos-desktop"
}
