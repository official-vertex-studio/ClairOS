{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions du bureau ClairOS",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "firefox",
          "cmd": "/usr/bin/firefox",
          "args": ["--new-window"]
        }
      ]
    }
  ]
}
